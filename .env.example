# LLM Provider Selection (gemini, anthropic, openai, moonshot)
# Default: gemini (has generous free tier for hackathons)
# Note: You can configure multiple API keys simultaneously for automatic fallback
LLM_PROVIDER=gemini

# Google Gemini API Key (recommended for hackathons - free tier available)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic API Key for Claude (optional - requires paid plan)
# Without this, the system uses rule-based responses
# The system will automatically fallback to this if Gemini fails
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (optional - requires paid credits)
# Get your key at: https://platform.openai.com/api-keys
# The system will automatically fallback to this if both Gemini and Anthropic fail
OPENAI_API_KEY=your_openai_api_key_here

# Moonshot (Kimi K3) API Key (optional - requires paid credits)
# Get your key at: https://platform.kimi.ai/console/api-keys
# Kimi K3 offers 1M token context window and OpenAI-compatible API
# The system will automatically fallback to this if other providers fail
MOONSHOT_API_KEY=your_moonshot_api_key_here

# Langfuse Observability (optional)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# Auto.dev API Key for real car data integration (optional)
# Without this, the system uses enhanced mock data with smart image matching
AUTO_DEV_API_KEY=your_auto_dev_api_key_here
